# Agent configuration reference. Values below are defaults or placeholders.
# Agent commands read exported process variables; they do not load dotenv files.
# Copy to agent/.env.local for personal values and export only the section needed by
# the process you are starting. Keep operator credentials in a separate shell.

# Runtime: go run ./agent/cmd/agent
# fixture (default): synthetic HTTP/SSE, no database or Worker required.
# local: real Worker authorization/balance reads plus persisted conversations.
# Both modes use real Gemini inference; deterministic models are test-only.
AGENT_MODE=fixture
AGENT_LISTEN_ADDR=127.0.0.1:8090

# Required only for local mode. Include the Worker's API prefix, if configured.
# Use a literal loopback address. Proxies, redirects and remote endpoints fail.
AGENT_WORKER_URL=http://127.0.0.1:8000

# Required only for local mode. Use the restricted Agent runtime login created
# by db-bootstrap, not the backend application or operator login.
# URL-encode password characters when placing them in a connection URL.
# Example: postgres://agent_state_runtime:REPLACE_PASSWORD@127.0.0.1:5432/expense_tracker?sslmode=disable
# sslmode=disable is for isolated local PostgreSQL only; use the appropriate
# TLS configuration for other database connections.
AGENT_STATE_DATABASE_URL=

# Bootstrap only: go run ./agent/cmd/db-bootstrap
# Export all three in a separate operator shell. The database must already
# exist. The operator needs schema-DDL and role-management permissions.
# The runtime role name must start with agent_state_. Set the same runtime
# password in AGENT_STATE_DATABASE_URL; bootstrap does not construct that URL.
# AGENT_STATE_ADMIN_DATABASE_URL='postgres://REPLACE_OPERATOR:REPLACE_PASSWORD@127.0.0.1:5432/expense_tracker?sslmode=disable'
# AGENT_STATE_DB_USER=agent_state_runtime
# AGENT_STATE_DB_PASSWORD='REPLACE_RUNTIME_PASSWORD'

# Optional integration tests: use disposable databases with synthetic data.
# Session/runtime/Worker integration tests are opt-in via AGENT_TEST_POSTGRES=1.
# Persistence tests also need AGENT_STATE_ADMIN_DATABASE_URL and
# AGENT_STATE_DATABASE_URL. They provision agent_state_test with the fixed
# synthetic password synthetic_state_password; point the runtime URL to that
# test login rather than agent_state_runtime.
# AGENT_TEST_POSTGRES=1
# AGENT_STATE_DATABASE_URL='postgres://agent_state_test:synthetic_state_password@127.0.0.1:5432/expense_tracker_test?sslmode=disable'

# Bootstrap integration tests use a separate operator URL, create/drop their
# own database and test role, and require CREATEDB plus CREATEROLE permissions.
# Unset or empty means those tests are skipped, independently of AGENT_TEST_POSTGRES.
# AGENT_MIGRATION_TEST_DATABASE_URL='postgres://REPLACE_TEST_OPERATOR:REPLACE_PASSWORD@127.0.0.1:5432/postgres?sslmode=disable'

# Worker-backed tests additionally use backend DB_PUBLIC_HOST, DB_PORT, DB_USER,
# DB_PASSWORD, DB_NAME and DB_SSLMODE. See agent/README.md for test commands.
# Start the local Worker separately with AGENT_MODE=local, MODE=debug and its
# own database/JWT configuration. AGENT_TOOL_ROLE_ARN belongs to the Worker's
# signed IAM boundary and is not required by the local Agent transport.

# Required for runtime inference in both modes. Supply your personal key locally.
GEMINI_API_KEY=

# Optional model profiles and per-turn limits; values shown are config defaults.
# Bundled skills select the default or router profile. Restart after changes.
AGENT_DEFAULT_MODEL=gemini-3.8-flash
AGENT_ROUTER_MODEL=gemini-3.5-flash-lite
AGENT_DEFAULT_MAX_OUTPUT_TOKENS=2048
AGENT_ROUTER_MAX_OUTPUT_TOKENS=2048
AGENT_MAX_MODEL_CALLS=6
AGENT_MAX_TOOL_CALLS=2
AGENT_MAX_STATE_UPDATES=4
AGENT_MAX_CONTEXT_BYTES=65536
AGENT_MAX_RESPONSE_BYTES=32768
AGENT_MAX_TOTAL_RESPONSE_BYTES=262144
AGENT_MAX_RESPONSE_EVENTS=256
